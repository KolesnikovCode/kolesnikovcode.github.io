---
import { getAbsoluteLocaleUrl } from 'astro:i18n';
import type { Locale } from '../i18n/ui';
import { getUi } from '../i18n/ui';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const t = getUi(locale);
const site = Astro.site ?? new URL('https://kolesnikovcode.github.io');
const ruUrl = new URL(getAbsoluteLocaleUrl('ru'), site).href;
const enUrl = new URL(getAbsoluteLocaleUrl('en'), site).href;
---

<!doctype html>
<html lang={locale} class="dark">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={t.metaDescription} />
		<link rel="sitemap" href="/sitemap-index.xml" />
		<link rel="alternate" hreflang="ru" href={ruUrl} />
		<link rel="alternate" hreflang="en" href={enUrl} />
		<link rel="alternate" hreflang="x-default" href={ruUrl} />
		<title>{t.metaTitle}</title>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700&family=Syne:wght@600;700;800&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body>
		<slot />
	</body>
</html>

<style is:global>
	html,
	body {
		margin: 0;
		min-height: 100%;
		background: #05080f;
		color: #f3f6f9;
	}

	html {
		scroll-behavior: smooth;
	}

	body {
		font-family: 'Manrope', sans-serif;
		-webkit-font-smoothing: antialiased;
		text-rendering: optimizeLegibility;
	}
</style>
